# Public site URL, used for the sitemap and canonical tags
NEXT_PUBLIC_SITE_URL=https://www.3on6.com

# Sanity — from sanity.io/manage. Leave blank to run on the built-in content (content/seed.ts + content/providers.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ── HighLevel: the 3 on 6 national sub-account ──────────────────────────────
# Settings → Private Integrations → token with contacts.write and locations/customFields.readonly.
HL_TOKEN=
HL_LOCATION=
# Optional test sub-account: when both are set, EVERY lead goes here (tagged website-test).
HL_TEST_TOKEN=
HL_TEST_LOCATION=
# "on" once the web_* custom fields exist in the sub-account (see README)
HL_CUSTOM_FIELDS=off
# If HighLevel rejects requests with a version error, set this to v3
HL_API_VERSION=2021-07-28
# Optional backup: if HighLevel is down, the lead is posted here instead (Zapier/Make/HL inbound webhook)
CONSULT_WEBHOOK_URL=

# HighLevel external tracking script for the 3 on 6 sub-account (off until set)
NEXT_PUBLIC_HL_TRACKING_ID=

# ── Tracking (each is off until its ID is set) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
NEXT_PUBLIC_META_PIXEL_ID=

# Official logo image (after `npm run pull:wix-images`), e.g. /img/3on6/logo-white.png. Blank = text wordmark.
NEXT_PUBLIC_LOGO_SRC=
